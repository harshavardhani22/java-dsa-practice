import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while(t-- > 0){
            int n = sc.nextInt();
            int m = sc.nextInt();

            HashSet<String> set = new HashSet<>();

            for(int i = 0; i < n; i++){
                String s = sc.next();

                char[] arr = s.toCharArray();
                Arrays.sort(arr);

                set.add(new String(arr));
            }

            System.out.println(set.size());
        }
    }
}
