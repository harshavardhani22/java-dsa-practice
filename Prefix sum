import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while(t-- > 0){

            int n = sc.nextInt();
            int q = sc.nextInt();

            long[] arr = new long[n];
            long[] ps = new long[n];

            for(int i = 0; i < n; i++){
                arr[i] = sc.nextLong();
            }

            ps[0] = arr[0];

            for(int i = 1; i < n; i++){
                ps[i] = ps[i - 1] + arr[i];
            }

            long total = ps[n - 1];

            while(q-- > 0){

                int l = sc.nextInt();
                int r = sc.nextInt();
                long k = sc.nextLong();

                long oldRange;

                if(l == 0){
                    oldRange = ps[r];
                } else {
                    oldRange = ps[r] - ps[l - 1];
                }

                long newTotal = total - oldRange + (long)(r - l + 1) * k;

                if(newTotal % 2 != 0){
                    System.out.println("YES " + newTotal);
                } else {
                    System.out.println("NO");
                }
            }
        }
    }
}
